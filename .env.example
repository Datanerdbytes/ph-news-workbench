# App
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to sign in (comma-separated, no spaces). Needed when the
# app is opened from another device on the LAN, e.g. http://192.168.1.20:3000
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=replace-with-a-long-random-string
CRON_SECRET=replace-with-a-random-string
# Invite-only signup. Set a code to let teammates create accounts; leave empty to close signups.
SIGNUP_INVITE_CODE=replace-with-an-invite-code

# Owner seeding (node seed-owner.js)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=nvapi-replace-me
# Fallback only: each workspace picks its own model in Settings → AI model.
# Must be one of the ids in lib/models.ts to take effect.
NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NIM_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium
NIM_PER_DRAFT_TOKEN_CAP=1500
NIM_DAILY_TOKEN_CAP=20000

# HyperFrames (local rendering)
# Used only when a workspace has not saved its own Video composer LLM key.
HF_API_KEY=
HF_MODEL=zai-org/GLM-5.3-Flash
# Rendering is enabled automatically by `next dev`; set to 1 only when running
# the app locally in production mode. Never enable this on Vercel.
HYPERFRAMES_ENABLE_RENDER=0
# Rendering needs the HyperFrames CLI, headless Chrome, and FFmpeg on this Mac.

# Local video downloads (yt-dlp)
# Defaults to ~/python-project/Projects/YT_DLP/my_venv/bin/python.
# Set this if your yt-dlp virtual environment lives elsewhere.
# YTDLP_PYTHON=/absolute/path/to/your/yt-dlp/venv/bin/python

# OpenAI (optional — enables AI image editing with gpt-image-1)
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the editing model (defaults to gpt-image-1).
# OPENAI_IMAGE_MODEL=gpt-image-1

# Facebook Page OAuth
# Create a Facebook app, add the Facebook Login product, and register the
# callback URL below as a Valid OAuth Redirect URI.
FACEBOOK_APP_ID=replace-with-your-app-id
FACEBOOK_APP_SECRET=replace-with-your-app-secret
FACEBOOK_GRAPH_VERSION=v23.0
# Optional: pin one Page when the login manages several.
# FACEBOOK_PAGE_ID=
# Optional: override the callback URL. It must match the Facebook app exactly.
# FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback
